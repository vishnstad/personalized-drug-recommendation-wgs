# Python
.venv/
__pycache__/
*.pyc

# Local micromamba / PharmCAT toolchain, not meant to be committed
.tools/
tools/

# data/raw/ and data/processed/ ARE committed (small, ~1.5MB, the milestone-1 deliverable)
# data/test/ stays ignored -- for local scratch testing only
data/test/*
!data/test/.gitkeep
data/processed/samples/
data/chroma_db/

# knowledge_graph/ pulls live from CPIC/HGNC/SIDER APIs on every run (regenerable,
# and the raw CPIC diplotype dump alone is ~120MB) -- cache is local-only, not committed
knowledge_graph/data/

# explainability render output (PyVis HTML) -- generated, not committed
explainability/output/

.env
*.log

# OS
.DS_Store
Thumbs.db
